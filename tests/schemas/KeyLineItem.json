{
  "$defs": {
    "CaseOutcome": {
      "enum": [
        "passed",
        "wrong",
        "timeout",
        "crashed"
      ],
      "title": "CaseOutcome",
      "type": "string"
    },
    "ItemStatus": {
      "enum": [
        "served",
        "retired"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "KeyLineChoice": {
      "properties": {
        "case_args": {
          "anyOf": [
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Args"
        },
        "case_expected": {
          "default": null,
          "title": "Case Expected"
        },
        "change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "returned": {
          "default": null,
          "title": "Returned"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "correct"
      ],
      "title": "KeyLineChoice",
      "type": "object"
    }
  },
  "properties": {
    "choices": {
      "items": {
        "$ref": "#/$defs/KeyLineChoice"
      },
      "maxItems": 4,
      "minItems": 3,
      "title": "Choices",
      "type": "array"
    },
    "code": {
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "form_digest": {
      "minLength": 1,
      "title": "Form Digest",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "line": {
      "minimum": 1,
      "title": "Line",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ItemStatus",
      "default": "served"
    },
    "template_id": {
      "title": "Template Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_at",
    "template_id",
    "form_digest",
    "code",
    "line",
    "choices"
  ],
  "title": "KeyLineItem",
  "type": "object"
