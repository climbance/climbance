{
  "$defs": {
    "CaseOutcome": {
      "enum": [
        "passed",
        "wrong",
        "timeout",
        "crashed"
      ],
      "title": "CaseOutcome",
      "type": "string"
    }
  },
  "properties": {
    "call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Id"
    },
    "cap_ms": {
      "exclusiveMinimum": 0,
      "title": "Cap Ms",
      "type": "integer"
    },
    "cases_passed": {
      "minimum": 0,
      "title": "Cases Passed",
      "type": "integer"
    },
    "cases_run": {
      "minimum": 0,
      "title": "Cases Run",
      "type": "integer"
    },
    "cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "effort": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pin"
    },
    "problem_id": {
      "minLength": 1,
      "title": "Problem Id",
      "type": "string"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Hash"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "runner": {
      "minLength": 1,
      "title": "Runner",
      "type": "string"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "try_number": {
      "minimum": 1,
      "title": "Try Number",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "created_at",
    "problem_id",
    "try_number",
    "cases_passed",
    "cases_run",
    "cap_ms",
    "runner"
  ],
  "title": "Trial",
  "type": "object"
}
