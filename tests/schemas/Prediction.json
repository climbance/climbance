      "default": null,
      "title": "Recall Probability"
    },
    "template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Id"
    },
    "user_id": {
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    }
